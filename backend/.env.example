# CareQ Environment Variables Configuration

# Database Configuration
# For Local Zero-Setup Development (Default):
DATABASE_URL="file:./dev.db"

# For PostgreSQL (Production / Docker / Cloud like Supabase/Neon/Railway):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/careq?schema=public"

# Server Configuration
PORT=5000
NODE_ENV="development"

# Security & Authentication
JWT_SECRET="careq-production-secure-jwt-secret-replace-in-real-deployment-389172"
JWT_EXPIRES_IN="7d"

# CORS & Client URL
FRONTEND_URL="http://localhost:5173"
