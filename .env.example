# CareQ — Smart Hospital Patient Queue Management System
# Master Environment Configuration

# Database Configuration:
# Default for zero-setup local run:
DATABASE_URL="file:./dev.db"

# PostgreSQL (Production / Docker):
# DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/careq?schema=public"

# Backend Server Configuration
PORT=5000
NODE_ENV="development"

# Security & Authentication
JWT_SECRET="careq-production-secure-jwt-secret-replace-in-real-deployment-389172"
JWT_EXPIRES_IN="7d"

# Frontend Origin
FRONTEND_URL="http://localhost:5173"
